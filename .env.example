# Copier vers .env (jamais commité)
LLM_PROVIDER=ollama            # ollama | azure_openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct   # variante sans mode réflexion (qwen3:4b réfléchit toujours : trop lent)
OLLAMA_EMBED_MODEL=bge-m3       # multilingue (corpus français)

# Azure (Phase 2+) — préférer Managed Identity, pas de clé en dur
# LLM_PROVIDER=azure_openai suffit : l'index vectoriel passe alors sur Azure AI Search
# (VECTOR_STORE=chroma|azure_search pour forcer). Authentification : az login, aucune clé.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBED_DEPLOYMENT=embeddings
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=corpus

# Agent de pré-analyse (docker compose up -d db) — identifiants de développement uniquement
DATABASE_URL=postgresql://publifin:publifin@localhost:5433/publifin

# Système complet en conteneurs (docker compose up -d --build). Ces variables ne servent qu'à
# docker compose ; dans les conteneurs, DATABASE_URL et CORS_ORIGINS sont fixées par le compose.
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434   # http://ollama:11434 avec --profile ollama
# API_PORT=8000                                         # changer de port impose de reconstruire le front
# WEB_PORT=3000
